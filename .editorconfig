root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,yml,yaml,tf}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[openapi/**]
generated_code = true

[src/ClimbOn.Client.Api/**]
generated_code = true

[**/Migrations/**]
generated_code = true
